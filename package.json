  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web",
    "build:pwa": "node scripts/build-pwa.mjs",
    "test:ui": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "qa:visual": "python3 scripts/compare-screens.py && python3 scripts/publish-qa.py",
    "format": "prettier --write App.tsx src tests",
    "lint": "eslint App.tsx src tests"
  },
  "private": true
