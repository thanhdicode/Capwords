# Optional public client configuration. Values in EXPO_PUBLIC_* are bundled
# into the app; never put secrets, passwords, JWTs, or provider API keys here.
# Leave these blank for local-only storage and manual word entry.
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_BUCKET_ID=
EXPO_PUBLIC_APPWRITE_PLATFORM=dev.study.capwordsclone

# Optional authenticated HTTPS recognition Worker. Leave blank for manual entry.
EXPO_PUBLIC_RECOGNITION_ENDPOINT=

# Set to 0 for a production web export to disable the development studio.
EXPO_PUBLIC_ENABLE_STUDIO=
